# Postgres connection. Inside Docker the host is the `db` service name;
# for running `prisma migrate dev` locally against the exposed container,
# use `localhost` instead of `db`.
DATABASE_URL="postgresql://reminder_user:reminder_pass@db:5432/reminder_db?schema=public"

# JWT configuration (IMPORTANT: Change JWT_SECRET to a strong random value in production)
JWT_SECRET="your-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="1d"

# Server configuration
PORT=3000
NODE_ENV="development"

# CORS configuration (comma-separated list of allowed origins for frontend)
# Examples: http://localhost:3001,http://localhost:8081,https://yourfrontend.com
CORS_ORIGIN="http://localhost:3001,http://localhost:8081"

# Swagger documentation (set to 'true' to enable, 'false' to disable)
ENABLE_SWAGGER="true"
